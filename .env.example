# Skelly's AI key. It stays on the server (never sent to the browser). Set ONE of these:
# Google Gemini (free tier, from aistudio.google.com -> Get API key):
GEMINI_API_KEY=
# Claude (paid, from console.anthropic.com):
ANTHROPIC_API_KEY=
# Optional: preferred Gemini model (default gemini-3.5-flash; others are tried if it is busy)
# GEMINI_MODEL=gemini-3.5-flash
# Optional: port for the Skelly API (default 8787)
# SKELLY_PORT=8787
